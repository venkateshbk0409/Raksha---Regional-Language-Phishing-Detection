# Environment Configuration for Raksha Backend
ENVIRONMENT=production

# Allowed CORS Origins (Vercel frontend domain and local development)
# Can be provided as JSON array or comma-separated string:
# e.g., ["https://raksha.vercel.app","http://localhost:5173"] or https://raksha.vercel.app,http://localhost:5173
CORS_ORIGINS=["https://<your-frontend>.vercel.app","http://localhost:5173","http://127.0.0.1:5173"]

# Rate Limiting (default: 30 requests per minute per IP)
RATE_LIMIT_PER_MINUTE=30

# Optional Privacy-Safe Telemetry (database.md)
# ENABLE_TELEMETRY=false
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=raksha_db
# MONGODB_COLLECTION=telemetry
